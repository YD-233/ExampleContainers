-include .env
-include .env.local

BINARY_NAME?=mythic_go_services
DEBUG_LEVEL?="trace"
RABBITMQ_HOST?="127.0.0.1"
RABBITMQ_PORT?="5672"
RABBITMQ_PASSWORD?=
MYTHIC_SERVER_HOST?="127.0.0.1"
MYTHIC_SERVER_PORT?="17443"
MYTHIC_SERVER_GRPC_PORT?="17444"
WEBHOOK_DEFAULT_URL?=
WEBHOOK_DEFAULT_CHANNEL?=
WEBHOOK_DEFAULT_FEEDBACK_CHANNEL?=
WEBHOOK_DEFAULT_CALLBACK_CHANNEL?=
WEBHOOK_DEFAULT_STARTUP_CHANNEL?=
MY_AGENT_PAYLOAD_UUID?=
MY_AGENT_CALLBACK_HOST?=https://127.0.0.1
MY_AGENT_CALLBACK_PORT?=8443
MY_AGENT_AESPSK?=
MY_AGENT_WS_CALLBACK_HOST?=${MY_AGENT_CALLBACK_HOST}
MY_AGENT_WS_CALLBACK_PORT?=${MY_AGENT_CALLBACK_PORT}
MY_AGENT_WS_AESPSK?=${MY_AGENT_AESPSK}
MY_AGENT_POLL_INTERVAL_SECONDS?=5
MY_AGENT_INSECURE_SKIP_VERIFY?=true
MY_AGENT_ENABLE_SESSION_MODE?=true
MY_AGENT_INTERACTIVE_SHELL?=

build:
	go mod tidy
	GOOS=linux go build -o ${BINARY_NAME} .
	cp ${BINARY_NAME} /

run:
	cp /${BINARY_NAME} .
	./${BINARY_NAME}

local:
	go build -o ${BINARY_NAME} .

run_custom: local
	DEBUG_LEVEL=${DEBUG_LEVEL} \
RABBITMQ_HOST=${RABBITMQ_HOST} \
RABBITMQ_PORT=${RABBITMQ_PORT} \
RABBITMQ_PASSWORD=${RABBITMQ_PASSWORD} \
MYTHIC_SERVER_HOST=${MYTHIC_SERVER_HOST} \
MYTHIC_SERVER_PORT=${MYTHIC_SERVER_PORT} \
MYTHIC_SERVER_GRPC_PORT=${MYTHIC_SERVER_GRPC_PORT} \
WEBHOOK_DEFAULT_URL=${WEBHOOK_DEFAULT_URL} \
WEBHOOK_DEFAULT_CHANNEL=${WEBHOOK_DEFAULT_CHANNEL} \
WEBHOOK_DEFAULT_FEEDBACK_CHANNEL=${WEBHOOK_DEFAULT_FEEDBACK_CHANNEL} \
WEBHOOK_DEFAULT_CALLBACK_CHANNEL=${WEBHOOK_DEFAULT_CALLBACK_CHANNEL} \
WEBHOOK_DEFAULT_STARTUP_CHANNEL=${WEBHOOK_DEFAULT_STARTUP_CHANNEL} \
./${BINARY_NAME}

# 本地调试 Payload Type 服务，不走 Docker 内部主机名。
run_local_service:
	@test -n "${RABBITMQ_PASSWORD}" || (echo "请先通过环境变量、.env 或 .env.local 提供 RABBITMQ_PASSWORD"; exit 1)
	DEBUG_LEVEL=${DEBUG_LEVEL} \
RABBITMQ_HOST=127.0.0.1 \
RABBITMQ_PORT=5672 \
RABBITMQ_PASSWORD=${RABBITMQ_PASSWORD} \
MYTHIC_SERVER_HOST=127.0.0.1 \
MYTHIC_SERVER_PORT=17443 \
MYTHIC_SERVER_GRPC_PORT=17444 \
WEBHOOK_DEFAULT_URL=${WEBHOOK_DEFAULT_URL} \
WEBHOOK_DEFAULT_CHANNEL=${WEBHOOK_DEFAULT_CHANNEL} \
WEBHOOK_DEFAULT_FEEDBACK_CHANNEL=${WEBHOOK_DEFAULT_FEEDBACK_CHANNEL} \
WEBHOOK_DEFAULT_CALLBACK_CHANNEL=${WEBHOOK_DEFAULT_CALLBACK_CHANNEL} \
WEBHOOK_DEFAULT_STARTUP_CHANNEL=${WEBHOOK_DEFAULT_STARTUP_CHANNEL} \
go run .

run_agent_local:
# 这里只是本地源码调试兜底；正式构建时功能裁剪由 Mythic 的命令勾选决定。
	MY_AGENT_PAYLOAD_UUID=${MY_AGENT_PAYLOAD_UUID} \
MY_AGENT_CALLBACK_HOST=${MY_AGENT_CALLBACK_HOST} \
MY_AGENT_CALLBACK_PORT=${MY_AGENT_CALLBACK_PORT} \
MY_AGENT_AESPSK=${MY_AGENT_AESPSK} \
MY_AGENT_WS_CALLBACK_HOST=${MY_AGENT_WS_CALLBACK_HOST} \
MY_AGENT_WS_CALLBACK_PORT=${MY_AGENT_WS_CALLBACK_PORT} \
	MY_AGENT_WS_AESPSK=${MY_AGENT_WS_AESPSK} \
	MY_AGENT_POLL_INTERVAL_SECONDS=${MY_AGENT_POLL_INTERVAL_SECONDS} \
	MY_AGENT_INSECURE_SKIP_VERIFY=${MY_AGENT_INSECURE_SKIP_VERIFY} \
	MY_AGENT_ENABLE_SESSION_MODE=${MY_AGENT_ENABLE_SESSION_MODE} \
	MY_AGENT_INTERACTIVE_SHELL=${MY_AGENT_INTERACTIVE_SHELL} \
	go run ./my_agent/agent_code
